---
import BaseLayout from "../layouts/BaseLayout.astro";
import CornerMarks from "../components/CornerMarks.astro";
import ToolCard from "../components/ToolCard.astro";
import HeroTitle from "../components/react/HeroTitle";
import HeroTicker from "../components/react/HeroTicker";
import LogoMarquee from "../components/react/LogoMarquee";
import {
  FEATURES,
  FEATURE_GROUPS,
  INTERFACE_LABELS,
  KIND_LABELS,
  KIND_PLURALS,
  PLATFORM_LABELS,
} from "../lib/features";
import { PLATFORMS, type ToolKind } from "../data/schema";
import {
  countByKind,
  formatDate,
  getAllTools,
  iconFor,
  latestVerified,
} from "../lib/tools";
import "../styles/home.css";

const tools = getAllTools();
const counts = countByKind();
const verified = latestVerified();
const total = tools.length;
const verifiedLabel = verified ? formatDate(verified) : null;

const logos = tools
  .flatMap((tool) => {
    const icon = iconFor(tool.slug);
    return icon
      ? [{ name: tool.name, src: icon, href: `/tools/${tool.slug}` }]
      : [];
  })
  .sort((a, b) => a.name.localeCompare(b.name, "en"));

const description =
  "An open, sourced directory of AI coding harnesses, orchestrators, cloud agents and add-ons. Compare features, check the facts behind each tool, and make your own tier list.";

const featureCounts = new Map(
  FEATURES.map((feature) => [
    feature.key,
    tools.filter((tool) => tool.features[feature.key] === true).length,
  ]),
);

const KIND_ORDER: readonly ToolKind[] = [
  "harness",
  "orchestrator",
  "cloud-agent",
  "add-on",
];

const kindCards: Array<{
  kind: ToolKind;
  label: string;
  count: number;
  blurb: string;
}> = [
  {
    kind: "harness",
    label: KIND_LABELS.harness,
    count: counts.harness,
    blurb: "Runs the agent: reads files, edits code, calls tools.",
  },
  {
    kind: "orchestrator",
    label: KIND_LABELS.orchestrator,
    count: counts.orchestrator,
    blurb: "Runs many sessions at once, with worktrees and review.",
  },
  {
    kind: "cloud-agent",
    label: KIND_LABELS["cloud-agent"],
    count: counts["cloud-agent"],
    blurb: "Works in a hosted sandbox and returns a pull request.",
  },
  {
    kind: "add-on",
    label: KIND_LABELS["add-on"],
    count: counts["add-on"],
    blurb: "Extends one harness or orchestrator with new commands.",
  },
];

const GRADES = ["S", "A", "B", "C", "D", "F"] as const;
const TIER_POOL_SIZE = GRADES.length * 4;

// A balanced sample board: four logos per grade, drawn round-robin from the
// kinds so the preview reads as a mixture rather than a ranking.
const buckets = KIND_ORDER.map((kind) =>
  tools
    .filter((tool) => tool.kind === kind && iconFor(tool.slug) !== null)
    .sort((a, b) => a.name.localeCompare(b.name, "en")),
);

const tierPool: Array<{ slug: string; name: string; src: string }> = [];
for (let index = 0; tierPool.length < TIER_POOL_SIZE; index += 1) {
  let added = false;
  for (const bucket of buckets) {
    const tool = bucket[index];
    if (tool && tierPool.length < TIER_POOL_SIZE) {
      tierPool.push({
        slug: tool.slug,
        name: tool.name,
        src: iconFor(tool.slug) ?? "",
      });
      added = true;
    }
  }
  if (!added) break;
}

const tierRows = GRADES.map((grade, index) => ({
  grade,
  items: tierPool.slice(index * 4, index * 4 + 4),
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ohmyharness",
  url: "https://ohmyharness.com",
  description,
  potentialAction: {
    "@type": "SearchAction",
    target: "https://ohmyharness.com/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout title="ohmyharness" description={description} jsonLd={jsonLd}>
  <div class="home">
    <section class="home-hero">
      <div class="container home-hero__inner">
        <CornerMarks />

        <p class="home-hero__kicker">
          <span>Community-maintained</span>
          <span>{total} entries</span>
          {verifiedLabel && <span>Verified {verifiedLabel}</span>}
        </p>

        <h1 class="home-display">
          <HeroTitle client:visible first="Pick your" second="harness" />
          <span class="home-display__cursor" aria-hidden="true"></span>
        </h1>

        <p class="home-hero__lede">
          An open, sourced index of the harnesses, orchestrators, cloud agents
          and add-ons that write code with you.
        </p>

        <form class="hero-search" role="search" data-hero-search>
          <label class="visually-hidden" for="hero-search"
            >Search the directory</label
          >
          <span class="hero-search__prompt" aria-hidden="true">/</span>
          <input
            id="hero-search"
            class="hero-search__input"
            type="search"
            name="q"
            placeholder={`Search ${total} tools — name, maker, feature…`}
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            data-filter-search
          />
          <kbd class="hero-search__kbd" aria-hidden="true">/</kbd>
          <button class="hero-search__submit" type="submit">
            <span class="hero-search__submit-label">Search</span>
            <span aria-hidden="true">→</span>
          </button>
        </form>

        <div class="home-hero__actions">
          <a class="btn btn--primary" href="#directory">Browse the directory ↓</a>
          <a class="btn" href="/tier-list">Make your tier list</a>
          <a class="btn btn--ghost" href="/compare">Compare features</a>
        </div>

        <HeroTicker
          client:visible
          harnesses={counts.harness}
          orchestrators={counts.orchestrator}
          cloudAgents={counts["cloud-agent"]}
          addOns={counts["add-on"]}
          verified={verifiedLabel}
        />
      </div>
    </section>

    {logos.length > 3 && (
      <section class="logo-strip" aria-label="Tools in the directory">
        <div class="container logo-strip__inner">
          <CornerMarks />
          <p class="logo-strip__label">In the directory</p>
          <div class="logo-strip__loop">
            <LogoMarquee client:visible logos={logos} />
          </div>
          <a class="logo-strip__more" href="#directory">
            {logos.length} tools <span aria-hidden="true">↓</span>
          </a>
        </div>
      </section>
    )}

    <section class="directory" id="directory" data-filters>
      <div class="container directory__intro">
        <div>
          <p class="eyebrow">The directory</p>
          <h2 class="directory__title">Every tool, one index.</h2>
        </div>
        <p class="directory__note">
          Every entry is checked against its sources. Unverified facts are
          marked <span class="mono">?</span>.
        </p>
      </div>

      <div data-toolbar-sentinel aria-hidden="true"></div>

      <div class="mobile-search">
        <label class="tb-search" for="mobile-search">
          <span class="tb-search__prompt" aria-hidden="true">/</span>
          <span class="visually-hidden">Search tools</span>
          <input
            id="mobile-search"
            type="search"
            placeholder={`Search ${total} tools`}
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            data-filter-search
          />
        </label>
      </div>

      <div class="dir-toolbar" data-toolbar>
        <div class="container dir-toolbar__inner">
          <div class="dir-toolbar__row">
            <div class="kind-tabs" role="group" aria-label="Filter by kind">
              <button
                class="kind-tab"
                type="button"
                data-filter-kind="all"
                aria-pressed="true"
              >
                <span class="kind-tab__label">All</span>
                <span class="kind-tab__count">{total}</span>
              </button>
              {KIND_ORDER.map((kind) => (
                <button
                  class="kind-tab"
                  type="button"
                  data-filter-kind={kind}
                  aria-pressed="false"
                >
                  <span class="kind-tab__label">{KIND_PLURALS[kind]}</span>
                  <span class="kind-tab__count">{counts[kind]}</span>
                </button>
              ))}
            </div>

            <div class="tb-controls">
              <label class="tb-field">
                <span class="tb-field__label">Price</span>
                <select id="filter-price">
                  <option value="any">Any</option>
                  <option value="free">Free plan</option>
                  <option value="under20">Under $20/mo</option>
                  <option value="under50">Under $50/mo</option>
                </select>
              </label>

              <label class="tb-field">
                <span class="tb-field__label">Platform</span>
                <select id="filter-platform">
                  <option value="">Any</option>
                  {PLATFORMS.map((platform) => (
                    <option value={platform}>
                      {PLATFORM_LABELS[platform]}
                    </option>
                  ))}
                </select>
              </label>

              <button
                class="tb-more"
                type="button"
                data-more-filters-toggle
                aria-expanded="false"
                aria-controls="more-filters"
              >
                More filters
                <span class="tb-more__badge" data-hidden-filter-count hidden
                  >0</span
                >
              </button>

              <label class="tb-field tb-field--sort">
                <span class="tb-field__label">Sort</span>
                <select id="filter-sort">
                  <option value="name">Name</option>
                  <option value="stars">Stars</option>
                  <option value="price">Lowest price</option>
                </select>
              </label>

              <span
                class="tb-count"
                id="results-count"
                role="status"
                aria-live="polite"
                >{total} tools</span
              >
            </div>
          </div>

          <div class="active-row" data-active-row hidden>
            <div class="active-filters" data-active-filters></div>
            <button
              class="active-row__clear"
              type="button"
              data-clear-filters
            >
              Clear all
            </button>
          </div>
        </div>
      </div>

      <div class="filters-backdrop" data-filters-backdrop hidden></div>

      <div
        class="more-panel"
        id="more-filters"
        data-more-filters-panel
        role="dialog"
        aria-modal="false"
        aria-labelledby="more-filters-title"
        hidden
      >
        <div class="more-panel__head">
          <p class="more-panel__title" id="more-filters-title">More filters</p>
          <button
            class="more-panel__close"
            type="button"
            data-more-filters-close
            aria-label="Close filters"
          >
            ✕
          </button>
        </div>

        <div class="more-panel__body">
          <div class="more-panel__selects">
            <label class="tb-field tb-field--block">
              <span class="tb-field__label">Source</span>
              <select id="filter-os">
                <option value="any">Any source</option>
                <option value="open">Open source</option>
                <option value="available">Source available</option>
                <option value="closed">Closed source</option>
              </select>
            </label>

            <label class="tb-field tb-field--block">
              <span class="tb-field__label">Interface</span>
              <select id="filter-interface">
                <option value="">Any interface</option>
                {Object.entries(INTERFACE_LABELS).map(([value, label]) => (
                  <option value={value}>{label}</option>
                ))}
              </select>
            </label>
          </div>

          {FEATURE_GROUPS.map((group) => (
            <fieldset class="filter-group">
              <legend class="filter-group__label">{group.label}</legend>
              <div class="check-grid">
                {group.features.map((feature) => (
                  <label class="chip">
                    <input
                      type="checkbox"
                      name="feature"
                      value={feature.key}
                    />
                    <span class="chip__text">{feature.label}</span>
                    <span class="chip__count">
                      {featureCounts.get(feature.key) ?? 0}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>

        <div class="more-panel__foot">
          <button
            class="btn btn--small btn--ghost"
            type="button"
            id="filter-reset"
          >
            Reset filters
          </button>
          <button
            class="btn btn--small"
            type="button"
            data-more-filters-close
          >
            Done
          </button>
        </div>
      </div>

      <noscript>
        <div class="container">
          <p class="inline-note">
            Filters need JavaScript. Every tool is listed below.
          </p>
        </div>
      </noscript>

      <div class="container directory__body">
        {total > 0 ? (
          <>
            <div class="dir-grid" data-tool-grid="first">
              {tools.slice(0, 6).map((tool) => <ToolCard tool={tool} />)}
            </div>

            <aside class="rank-band" aria-labelledby="rank-band-title">
              <CornerMarks />
              <div class="rank-band__head">
                <div>
                  <p class="eyebrow">Tier list</p>
                  <h2 class="rank-band__title" id="rank-band-title">
                    Not sure? Rank them.
                  </h2>
                </div>
                <div class="rank-band__aside">
                  <p>
                    Put any tool from S to F and share the board you end up
                    with.
                  </p>
                  <a class="btn btn--small" href="/tier-list">
                    Open the tier list <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>

              <div class="rank-preview">
                <div class="rank-preview__inner">
                  {tierRows.map((row) => (
                    <div class="rank-row">
                      <span
                        class:list={[
                          "rank-row__grade",
                          `rank-row__grade--${row.grade.toLowerCase()}`,
                        ]}
                      >
                        {row.grade}
                      </span>
                      <div class="rank-row__tiles">
                        {row.items.map((item) => (
                          <a
                            class="rank-tile"
                            href={`/tools/${item.slug}`}
                            title={item.name}
                          >
                            <img
                              src={item.src}
                              alt=""
                              width="22"
                              height="22"
                              loading="lazy"
                              decoding="async"
                            />
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <p class="rank-band__note">
                A sample board. Nothing is ranked until you rank it.
              </p>
            </aside>

            <div class="dir-grid" data-tool-grid="rest">
              {tools.slice(6).map((tool) => <ToolCard tool={tool} />)}
            </div>
          </>
        ) : (
          <div class="empty-state">
            <p class="eyebrow">Empty directory</p>
            <h2>No tools listed yet.</h2>
            <p class="lede">
              The first entry can be yours. Add a JSON file and open a pull
              request.
            </p>
            <a
              class="btn btn--primary"
              href="https://github.com/ohmyharness/ohmyharness/issues/new?template=add-tool.yml"
            >
              Suggest a tool ↗
            </a>
          </div>
        )}

        <div class="empty-state" id="filter-empty" hidden>
          <h2>No tools match these filters.</h2>
          <p class="muted">Try a different search, or clear the filters.</p>
        </div>
      </div>
    </section>

    <section class="kinds">
      <div class="container kinds__inner">
        <div class="kinds__head">
          <div>
            <p class="eyebrow">Four kinds of tool</p>
            <h2 class="kinds__title">Know what you are looking at.</h2>
          </div>
          <p class="kinds__legend">
            <span><span class="glyph glyph--yes">✓</span> verified</span>
            <span><span class="glyph glyph--no">✗</span> not verified</span>
            <span><span class="glyph glyph--unknown">?</span> not checked yet</span>
            <a href="/about#legend">What this means</a>
          </p>
        </div>

        <div class="kinds__grid">
          {kindCards.map((card) => (
            <a
              class="kind-card"
              href={`/?kind=${card.kind}#directory`}
              data-kind-link={card.kind}
            >
              <span class="kind-card__count">{card.count}</span>
              <span class="kind-card__name">{card.label}</span>
              <span class="kind-card__blurb">{card.blurb}</span>
              <span class="kind-card__go" aria-hidden="true">Browse →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <aside
    class="compare-tray"
    data-compare-tray
    aria-label="Comparison tray"
    hidden
  >
    <div class="compare-tray__inner">
      <div class="compare-tray__top">
        <p class="compare-tray__title">
          Compare <span data-compare-count>0</span
          ><span class="compare-tray__of">/4</span>
        </p>
        <p class="compare-tray__hint" data-compare-hint>Pick 2–4 tools</p>
      </div>
      <ul class="compare-tray__items" data-compare-items></ul>
      <div class="compare-tray__actions">
        <button class="compare-tray__clear" type="button" data-compare-clear>
          Clear
        </button>
        <a
          class="compare-tray__cta"
          data-compare-link
          data-compare-cta
          href="/compare"
          aria-disabled="true"
        >
          Compare <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </aside>

  <p
    class="visually-hidden"
    role="status"
    aria-live="polite"
    data-compare-status
  ></p>

  <nav class="mobile-bar" aria-label="Directory actions">
    <button class="mobile-bar__item" type="button" data-mobile-search>
      <span class="mobile-bar__icon" aria-hidden="true">⌕</span>
      Search
    </button>
    <button
      class="mobile-bar__item"
      type="button"
      data-mobile-filters
      aria-expanded="false"
      aria-controls="more-filters"
    >
      <span class="mobile-bar__icon" aria-hidden="true">≡</span>
      Filters
    </button>
    <a
      class="mobile-bar__item"
      data-compare-link
      data-mobile-compare
      href="/compare"
    >
      <span class="mobile-bar__icon" aria-hidden="true">⇄</span>
      Compare <span data-compare-count>0</span>
    </a>
  </nav>
</BaseLayout>

<script>
  import "../scripts/filters";
  import "../scripts/home";
  import "../scripts/install";
</script>
