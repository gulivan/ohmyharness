---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlitchText from "../components/react/reactbits/GlitchText";

const note = "This harness wandered off.";
---

<BaseLayout
  title="Page not found"
  description="That page is not in the ohmyharness directory."
  path="/404"
  noindex
>
  <div class="container notfound" data-crosshair>
    <p class="eyebrow">404 / not found</p>
    <div class="notfound__code" aria-hidden="true">
      <GlitchText
        client:load
        mode="slices"
        trigger="always"
        intensity={0.4}
        speed={0.6}
        offset={7}
        shadowColors={["#d7ff3f", "#a5a29a"]}
      >
        404
      </GlitchText>
    </div>
    <p class="notfound__note" aria-label={note}>
      {note.split("").map((char, index) => (
        <span aria-hidden="true" style={`--i:${index}`}>
          {char === " " ? "\u00A0" : char}
        </span>
      ))}
    </p>
    <h1 class="page-title">That page is not here.</h1>
    <p class="lede">
      The link may be old, or the tool may have been removed. Start from the
      directory.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">Browse the directory</a>
      <a class="btn" href="/compare">Compare tools</a>
      <a class="btn btn--ghost" href="/tier-list">Make a tier list</a>
    </div>
  </div>
</BaseLayout>
