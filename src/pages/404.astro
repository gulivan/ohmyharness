---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="That page is not in the ohmyharness directory."
  path="/404"
  noindex
>
  <div class="container notfound">
    <p class="eyebrow">404 / not found</p>
    <div class="notfound__code" aria-hidden="true">404</div>
    <h1 class="page-title">That page is not here.</h1>
    <p class="lede">
      The link may be old, or the tool may have been removed. Start from the
      directory.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">Browse the directory</a>
      <a class="btn" href="/compare">Compare tools</a>
      <a class="btn btn--ghost" href="/tier-list">Make a tier list</a>
    </div>
  </div>
</BaseLayout>
