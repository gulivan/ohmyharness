---
import BaseLayout from "../layouts/BaseLayout.astro";
import Monogram from "../components/Monogram.astro";
import Glyph from "../components/Glyph.astro";
import {
  FEATURE_GROUPS,
  KIND_LABELS,
  KIND_PLURALS,
  PRICING_LABELS,
  groupStats,
  sourceLabel,
} from "../lib/features";
import { getAllTools, iconFor, REPO_URL } from "../lib/tools";
import { startingPrice } from "../lib/pricing";

const tools = getAllTools();
const clientTools = tools.map((tool) => ({ ...tool, icon: iconFor(tool.slug) }));
const description =
  "Compare AI coding harnesses, orchestrators, cloud agents and add-ons side by side: providers, parallel agents, worktrees, pull requests, automations, MCP, remote access, sandboxing and pricing.";

const pricingLabel = (value: string | null): string =>
  value ? (PRICING_LABELS[value] ?? value) : "?";

const groupCounts = FEATURE_GROUPS.map((group) => ({
  key: group.key,
  ...groupStats(group, tools),
}));

const KIND_ORDER = ["harness", "orchestrator", "cloud-agent", "add-on"] as const;
const groups = KIND_ORDER.map((kind) => ({
  kind,
  label: KIND_PLURALS[kind],
  tools: tools.filter((tool) => tool.kind === kind),
})).filter((group) => group.tools.length > 0);
---

<BaseLayout title="Compare" description={description} path="/compare">
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Feature matrix</p>
      <h1 class="page-title">Compare tools</h1>
      <p class="lede">
        Put up to four tools side by side, or scan every tool in the matrix
        below. Confirmed facts show ✓ and ✗; anything still unchecked shows ?.
      </p>
    </header>
  </div>

  <section class="section section--flush">
    <div class="container">
      {tools.length > 0 ? (
        <>
          <div class="compare-picker" id="compare-picker">
            <div class="spread">
              <span class="small">Pick up to four tools</span>
              <span class="small">{tools.length} available</span>
            </div>
            <label class="field picker-search">
              <span class="field__prefix" aria-hidden="true">/</span>
              <span class="visually-hidden">Filter tools by name or maker</span>
              <input
                id="picker-search"
                type="search"
                placeholder="Filter by name or maker…"
                autocomplete="off"
                spellcheck="false"
              />
            </label>
            <div class="picker-tray" id="picker-tray" hidden>
              <span class="picker-tray__count" id="picker-count">0 selected</span>
              <span class="picker-tray__names" id="picker-names"></span>
              <button class="btn btn--small btn--ghost" type="button" id="picker-clear">Clear</button>
            </div>
            <div class="picker-list" id="picker-list">
              {groups.map((group) => (
                <section
                  class="picker-group"
                  data-picker-group={group.kind}
                  aria-labelledby={`picker-group-${group.kind}`}
                >
                  <h2 class="picker-group__title" id={`picker-group-${group.kind}`}>
                    {group.label} <span aria-hidden="true" data-group-count>{group.tools.length}</span>
                  </h2>
                  <div class="picker-group__items">
                    {group.tools.map((tool) => (
                      <button
                        class="pick"
                        type="button"
                        data-slug={tool.slug}
                        data-name={tool.name.toLowerCase()}
                        data-maker={(tool.maker ?? "").toLowerCase()}
                        aria-pressed="false"
                      >
                        <Monogram slug={tool.slug} name={tool.name} size="sm" />
                        <span class="pick__name">{tool.name}</span>
                        <span class="pick__meta">{sourceLabel(tool)}</span>
                      </button>
                    ))}
                  </div>
                </section>
              ))}
              <p class="picker-empty" id="picker-empty" hidden>No tools match that search.</p>
            </div>
            <div class="row">
              <button class="btn btn--small btn--ghost" type="button" id="compare-copy">Copy link</button>
              <span class="compare-status" id="compare-status" role="status" aria-live="polite"></span>
            </div>
          </div>

          <div class="compare-region">
            <div class="empty-state" id="compare-empty">
              <h2>Nothing selected yet.</h2>
              <p class="muted">Pick two or more tools above to see them side by side.</p>
            </div>
            <div id="compare-panel"></div>
          </div>

          <div class="matrix-toolbar">
            <div class="chip-row" role="group" aria-label="Filter the matrix by kind">
              <button class="chip" type="button" data-matrix-kind="all" aria-pressed="true">All</button>
              <button class="chip" type="button" data-matrix-kind="harness" aria-pressed="false">Harnesses</button>
              <button class="chip" type="button" data-matrix-kind="orchestrator" aria-pressed="false">Orchestrators</button>
              <button class="chip" type="button" data-matrix-kind="cloud-agent" aria-pressed="false">Cloud agents</button>
              <button class="chip" type="button" data-matrix-kind="add-on" aria-pressed="false">Add-ons</button>
            </div>
            <span class="matrix-toolbar__count" id="matrix-count">{tools.length} {tools.length === 1 ? "tool" : "tools"}</span>
          </div>

          <div class="matrix-scroll" data-matrix-scroll>
            <div class="matrix-wrap">
              <table class="matrix" id="matrix">
                <caption class="visually-hidden">
                  Feature comparison of all {tools.length} tools
                </caption>
                <thead>
                <tr class="matrix-groups">
                  <th scope="col" rowspan="2">Tool</th>
                  <th scope="col" rowspan="2">Type</th>
                  <th scope="col" rowspan="2">Pricing</th>
                  <th scope="col" rowspan="2" title="Cheapest listed price">From</th>
                  <th scope="col" rowspan="2">Source</th>
                  {FEATURE_GROUPS.map((group, index) => {
                    const counts = groupCounts[index];
                    return (
                      <th
                        scope="colgroup"
                        colspan={group.features.length}
                        class="matrix-group"
                        data-matrix-group-head={group.key}
                      >
                        <button
                          class="matrix-group__toggle"
                          type="button"
                          data-matrix-group={group.key}
                          aria-expanded="true"
                          aria-controls={`matrix-group-${group.key}`}
                        >
                          <span class="matrix-group__arrow" aria-hidden="true">▾</span>
                          <span class="matrix-group__label">{group.label}</span>
                          <span
                            class="matrix-group__count"
                            data-group-yes
                            title={`${group.label}: ${counts.yes} yes of ${counts.applicable} applicable cells`}
                          >{counts.yes}/{counts.applicable} yes</span>
                        </button>
                      </th>
                    );
                  })}
                </tr>
                <tr class="matrix-features" id="matrix-group-row">
                  {FEATURE_GROUPS.flatMap((group) =>
                    group.features.map((feature) => (
                      <th
                        scope="col"
                        title={feature.question}
                        data-feature-group={group.key}
                        data-feature-key={feature.key}
                      >{feature.label}</th>
                    )),
                  )}
                </tr>
              </thead>
              <tbody>
                {tools.map((tool) => (
                  <tr data-row-kind={tool.kind} data-slug={tool.slug}>
                    <th scope="row">
                      <span class="m-name">
                        <Monogram slug={tool.slug} name={tool.name} size="sm" />
                        <a href={`/tools/${tool.slug}`}>{tool.name}</a>
                      </span>
                    </th>
                    <td>{KIND_LABELS[tool.kind]}</td>
                    <td>{pricingLabel(tool.pricing.model)}</td>
                    <td>{startingPrice(tool)?.label ?? "?"}</td>
                    <td>{sourceLabel(tool)}</td>
                    {FEATURE_GROUPS.flatMap((group) =>
                      group.features.map((feature) => (
                        <td
                          data-feature-group={group.key}
                          data-feature-key={feature.key}
                        >
                          <Glyph
                            value={tool.features[feature.key]}
                            label={feature.label}
                            applicable={feature.appliesTo.includes(tool.kind)}
                          />
                        </td>
                      )),
                    )}
                  </tr>
                ))}
              </tbody>
              </table>
            </div>
            <div class="matrix-fade" aria-hidden="true"></div>
          </div>
          <p class="matrix-cue" id="matrix-cue" hidden>Swipe for more columns →</p>

          <div class="legend-row">
            <div class="legend" aria-label="Feature legend">
              <span><Glyph value={true} label="Example" /> yes</span>
              <span><Glyph value={false} label="Example" /> no</span>
              <span><Glyph value={null} label="Example" /> not verified yet</span>
              <span class="legend__na">– does not apply</span>
            </div>
            <span class="legend-links">
              <a class="small" href="/features">How features are defined</a>
              <a class="small" href="/about#legend">How we check facts</a>
            </span>
          </div>
        </>
      ) : (
        <div class="empty-state">
          <h2>No tools to compare yet.</h2>
          <p class="lede">Add the first entry and the matrix will build itself.</p>
          <a class="btn btn--primary" href={`${REPO_URL}/issues/new?template=add-tool.yml`}>Suggest a tool ↗</a>
        </div>
      )}
    </div>
  </section>

  <script
    type="application/json"
    id="compare-data"
    set:html={JSON.stringify(clientTools).replace(/</g, "\\u003c")}
  ></script>
</BaseLayout>

<script>
  import "../scripts/compare";
</script>
