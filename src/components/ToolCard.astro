---
import type { Tool } from "../data/schema";
import {
  KIND_LABELS,
  PLATFORM_LABELS,
  PLATFORM_SHORT_LABELS,
  applicableFeatures,
  confirmedFeatures,
  featureState,
  prioritisedFeatures,
  sourceLabel,
  sourceState,
  verifiedFeatureCount,
} from "../lib/features";
import { cheapestMonthly, hasFreePlan, priceLabel } from "../lib/pricing";
import { formatStars } from "../lib/tools";
import Monogram from "./Monogram.astro";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const searchText = [
  tool.name,
  tool.tagline,
  tool.description,
  tool.maker ?? "",
  KIND_LABELS[tool.kind],
  ...tool.platforms,
  ...tool.interfaces,
  ...tool.modelAccess,
  tool.license ?? "",
]
  .join(" ")
  .toLowerCase();

const pricing = priceLabel(tool);
const monthly = cheapestMonthly(tool);
const source = sourceLabel(tool);
const install = tool.install[0] ?? null;
const coverage = verifiedFeatureCount(tool);
const tierHref = `/tier-list?add=${tool.slug}#v1|S~A~B~C~D|`;

const applicable = applicableFeatures(tool.kind);
const byKey = new Map(applicable.map((feature) => [feature.key, feature]));
const confirmed = prioritisedFeatures(tool)
  .map((key) => byKey.get(key))
  .filter((feature) => feature !== undefined);
const visibleTags = confirmed.slice(0, 3);
const hiddenTags = confirmed.slice(3);
const unknown = applicable.filter(
  (feature) => tool.features[feature.key] === null,
);
const meterPercent =
  coverage.total > 0
    ? Math.round((coverage.verified / coverage.total) * 100)
    : 0;

const verifyLabel = [
  `Feature coverage: ${coverage.verified} of ${coverage.total} applicable features verified.`,
  unknown.length > 0
    ? `Not verified: ${unknown.map((feature) => feature.label).join(", ")}.`
    : "Every applicable feature is verified.",
].join(" ");

const platforms = tool.platforms.map((value) => ({
  short: PLATFORM_SHORT_LABELS[value] ?? value,
  label: PLATFORM_LABELS[value] ?? value,
}));

const metaTitle = [
  pricing,
  source,
  tool.github ? `${formatStars(tool.github.stars)} stars` : null,
  platforms.map((platform) => platform.label).join(", "),
]
  .filter(Boolean)
  .join(" · ");
---

<article
  class="tcard"
  data-tool
  data-slug={tool.slug}
  data-kind={tool.kind}
  data-name={tool.name}
  data-search={searchText}
  data-platforms={tool.platforms.join(" ")}
  data-interfaces={tool.interfaces.join(" ")}
  data-source={sourceState(tool)}
  data-features={confirmedFeatures(tool).join(" ")}
  data-pricing={tool.pricing.model ?? ""}
  data-price-free={hasFreePlan(tool) ? "true" : "false"}
  data-price-monthly={monthly ?? ""}
  data-stars={tool.github ? String(tool.github.stars) : ""}
>
  <div class="tcard__head">
    <Monogram slug={tool.slug} name={tool.name} size="sm" />
    <div class="tcard__id">
      <h3 class="tcard__name">
        <a href={`/tools/${tool.slug}`}>{tool.name}</a>
      </h3>
      <p class="tcard__kind">
        {KIND_LABELS[tool.kind]}{tool.status !== "active" && (
          <span class="tcard__status"> · {tool.status}</span>
        )}
      </p>
    </div>
    <button
      class="tcard__compare"
      type="button"
      data-compare-toggle
      data-slug={tool.slug}
      data-name={tool.name}
      aria-pressed="false"
      aria-label={`Add ${tool.name} to comparison`}
    >
      <span class="tcard__check" aria-hidden="true"></span>
      <span class="tcard__compare-label" aria-hidden="true">Compare</span>
    </button>
  </div>

  <p class="tcard__tagline">{tool.tagline}</p>

  <div class="tcard__mid">
    <ul class="tcard__tags" aria-label="Confirmed features">
      {visibleTags.map((feature) => (
        <li class="tcard__tag">{feature.label}</li>
      ))}
      {hiddenTags.length > 0 && (
        <li
          class="tcard__tag tcard__tag--more"
          title={hiddenTags.map((feature) => feature.label).join(", ")}
        >
          +{hiddenTags.length}
        </li>
      )}
    </ul>

    <div
      class="tcard__verify"
      role="img"
      aria-label={verifyLabel}
      title={verifyLabel}
    >
      <span
        class:list={[
          "tcard__meter",
          { "tcard__meter--bar": applicable.length > 10 },
        ]}
        aria-hidden="true"
      >
        {applicable.length > 10 ? (
          <span class="tcard__meter-fill" style={`width:${meterPercent}%`}></span>
        ) : (
          applicable.map((feature) => (
            <span
              class:list={[
                "tcard__meter-seg",
                `tcard__meter-seg--${featureState(tool.features[feature.key])}`,
              ]}
            />
          ))
        )}
      </span>
      <span class="tcard__verify-text">
        {coverage.verified}/{coverage.total} verified
      </span>
    </div>
  </div>

  <p class="tcard__meta" title={metaTitle}>
    <span class="tcard__price">{pricing}</span>
    <span>{source}</span>
    {tool.github && (
      <span class="tcard__stars">★ {formatStars(tool.github.stars)}</span>
    )}
    {platforms.length > 0 && (
      <span class="tcard__platforms">
        {platforms.map((platform) => (
          <abbr title={platform.label}>{platform.short}</abbr>
        ))}
      </span>
    )}
  </p>

  <div class="tcard__foot">
    {install &&
      (install.type === "command" ? (
        <div class="tcard__install">
          <span class="tcard__install-prompt" aria-hidden="true">$</span>
          <code class="tcard__install-text">{install.value}</code>
          <button
            class="tcard__copy"
            type="button"
            data-copy-text={install.value}
            data-copied-label="✓"
            data-copy-message={`${tool.name} install command copied`}
            aria-label={`Copy the install command for ${tool.name}`}
          >
            <span aria-hidden="true" data-copy-feedback>⧉</span>
          </button>
        </div>
      ) : (
        <a
          class="tcard__get"
          href={install.value}
          target="_blank"
          rel="noopener"
        >
          Get {tool.name} ↗
        </a>
      ))}

    <a class="tcard__tier" href={tierHref}>Tier list +</a>
  </div>
</article>
