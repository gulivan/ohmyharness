---
import type { Tool } from "../data/schema";
import {
  FEATURES,
  INTERFACE_LABELS,
  KIND_LABELS,
  PLATFORM_LABELS,
  confirmedFeatures,
  sourceLabel,
  sourceState,
  verifiedFeatureCount,
} from "../lib/features";
import {
  cheapestMonthly,
  hasFreePlan,
  priceLabel,
} from "../lib/pricing";
import { formatStars } from "../lib/tools";
import Glyph from "./Glyph.astro";
import Monogram from "./Monogram.astro";

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

const searchText = [
  tool.name,
  tool.tagline,
  tool.description,
  tool.maker ?? "",
  KIND_LABELS[tool.kind],
  ...tool.platforms,
  ...tool.interfaces,
  ...tool.modelAccess,
  tool.license ?? "",
]
  .join(" ")
  .toLowerCase();

const platforms =
  tool.platforms.length > 0
    ? tool.platforms.map((value) => PLATFORM_LABELS[value] ?? value).join(" / ")
    : "Platforms ?";

const interfaces =
  tool.interfaces.length > 0
    ? tool.interfaces.map((value) => INTERFACE_LABELS[value] ?? value).join(" / ")
    : "Interfaces ?";

const pricing = priceLabel(tool);
const monthly = cheapestMonthly(tool);

const source = sourceLabel(tool);
const install = tool.install[0] ?? null;
const coverage = verifiedFeatureCount(tool);
const tierHref = `/tier-list?add=${tool.slug}#v1|S~A~B~C~D|`;
---

<article
  class="tool-card"
  data-tool
  data-slug={tool.slug}
  data-kind={tool.kind}
  data-name={tool.name}
  data-search={searchText}
  data-platforms={tool.platforms.join(" ")}
  data-interfaces={tool.interfaces.join(" ")}
  data-source={sourceState(tool)}
  data-features={confirmedFeatures(tool).join(" ")}
  data-pricing={tool.pricing.model ?? ""}
  data-price-free={hasFreePlan(tool) ? "true" : "false"}
  data-price-monthly={monthly ?? ""}
  data-stars={tool.github ? String(tool.github.stars) : ""}
>
  <div class="tool-card__top">
    <Monogram slug={tool.slug} name={tool.name} />
    <span class="tool-card__kind">
      {KIND_LABELS[tool.kind]}{tool.status !== "active" ? ` · ${tool.status}` : ""}
    </span>
  </div>

  <h3 class="tool-card__name">
    <a href={`/tools/${tool.slug}`}>{tool.name}</a>
  </h3>

  <p class="tool-card__tagline">{tool.tagline}</p>

  <div class="tool-card__features" aria-label="Features">
    {FEATURES.map((feature) => (
      <Glyph value={tool.features[feature.key]} label={feature.label} />
    ))}
    <span
      class="verified-chip"
      title={`${coverage.verified} of ${coverage.total} features checked`}
    >Verified {coverage.verified}/{coverage.total}</span>
  </div>

  <div class="tool-card__meta">
    <span>{platforms}</span>
    <span class="dot tool-card__price">{pricing}</span>
    <span class="dot">{source}</span>
    {tool.github && <span class="dot">★ {formatStars(tool.github.stars)}</span>}
    <a class="tool-card__tier" href={tierHref}>Add to tier list</a>
  </div>

  {install && (
    <div class="tool-card__install">
      {install.type === "command" ? (
        <>
          <span class="tool-card__install-prompt" aria-hidden="true">$</span>
          <code class="tool-card__install-text">{install.value}</code>
          <button
            class="tool-card__copy"
            type="button"
            data-copy-text={install.value}
            data-copied-label="✓"
            data-copy-message={`${tool.name} install command copied`}
            aria-label={`Copy the install command for ${tool.name}`}
          >
            <span aria-hidden="true" data-copy-feedback>⧉</span>
          </button>
        </>
      ) : (
        <a
          class="tool-card__get"
          href={install.value}
          target="_blank"
          rel="noopener"
        >
          Get {tool.name} ↗
        </a>
      )}
    </div>
  )}

  <span class="visually-hidden">{interfaces}</span>
</article>
