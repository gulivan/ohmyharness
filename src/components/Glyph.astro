---
import { featureState, glyph, glyphWord } from "../lib/features";

interface Props {
  value: boolean | null;
  label: string;
  /** False renders the “not applicable” dash instead of a yes/no/unknown glyph. */
  applicable?: boolean;
  large?: boolean;
}

const { value, label, applicable = true, large = false } = Astro.props;
const state = featureState(value, applicable);
const word = glyphWord(value, applicable);
---

<span
  class:list={["glyph", `glyph--${state}`, { "glyph--lg": large }]}
  role="img"
  aria-label={`${label}: ${word}`}
  title={`${label}: ${word}`}
>{glyph(value, applicable)}</span>
